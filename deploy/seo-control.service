[Unit]
Description=Fanz SEO URL notifications
After=network-online.target fans-platform.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/fans/current
EnvironmentFile=/home/deploy/fans/shared/runtime.env
ExecStart=/home/deploy/.nvm/versions/node/v22.23.2/bin/node /home/deploy/fans/current/deploy/seo-worker.mjs
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/deploy/fans/shared
